[Unit]
Description=SpliceFS mounts
Documentation=https://github.com/SpliceFS/client
After=network-online.target
Wants=network-online.target

[Service]
# The client reports READY once every configured mount is up, so units ordered after this
# one can rely on the mounts being there. With nothing configured it runs without mounts.
Type=notify
ExecStart=/usr/local/bin/splicefs mount
# The client applies its configuration again on SIGHUP: added mounts are mounted, removed
# ones are detached, changed ones are mounted again, and a configuration with an error is
# refused and only logged.
ExecReload=/bin/kill -HUP $MAINPID
# The client sends a heartbeat every ten seconds from the loop that owns the mounts. If
# that loop is stuck for five minutes, systemd kills the client and Restart= starts it
# again. A mount that stops answering is handled by the client itself, without a restart.
WatchdogSec=300
Restart=on-failure
RestartSec=5
# Creates /var/cache/splicefs, the default cache directory, owned by the service user.
CacheDirectory=splicefs
# Running as root needs no FUSE helper package. To run as another user, set User=
# here and install the fuse3 package.

[Install]
WantedBy=multi-user.target
