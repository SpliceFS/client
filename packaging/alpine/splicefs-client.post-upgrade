#!/bin/sh
# Versions before the control tool linked the helper in /sbin to the splicefs program, which is
# not the helper any more. A link that an administrator pointed elsewhere is left alone.
# readlink fails when there is no link, and then there is nothing to change.
helper_target="$(readlink /sbin/mount.splicefs 2>/dev/null)" || helper_target=""
if [ ! -L /sbin ] && [ "$helper_target" = /usr/bin/splicefs ]; then
    ln -sf /usr/bin/splicefsctl /sbin/mount.splicefs
fi
# A broken configuration must not turn an upgrade into a failed install.
if [ -e /run/openrc/softlevel ]; then
    rc-service --ifstarted splicefs restart ||
        echo "splicefs did not restart; see /var/log/splicefs.log" >&2
fi
exit 0
