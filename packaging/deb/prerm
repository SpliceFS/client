#!/bin/sh
# Runs before the package's files are removed. On an upgrade the service keeps running
# and the new version's postinst restarts it.
set -e

case "$1" in
    remove | deconfigure)
        # The link made at install time for systems where /sbin is its own folder.
        # readlink fails when there is no link, and then there is nothing to remove.
        helper_target="$(readlink /sbin/mount.splicefs 2>/dev/null)" || helper_target=""
        if [ ! -L /sbin ] && [ "$helper_target" = /usr/bin/splicefs ]; then
            rm -f /sbin/mount.splicefs
        fi
        if [ -d /run/systemd/system ]; then
            systemctl disable --now splicefs.service || true
        fi
        ;;
    *)
        # An upgrade keeps the service running, and a failed upgrade needs nothing here.
        ;;
esac
