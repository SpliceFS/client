#!/sbin/openrc-run
# OpenRC service of the SpliceFS client, for systems without systemd (Alpine).

description="SpliceFS mounts"
# supervise-daemon restarts the client when it exits with an error, which is what
# Restart=on-failure does in the systemd unit. Stopping the service unmounts everything.
supervisor=supervise-daemon
command=/usr/bin/splicefs
command_args="mount"
output_log=/var/log/splicefs.log
error_log=/var/log/splicefs.log
extra_started_commands="reload"
description_reload="Apply the configuration without a restart"

depend() {
    need net
    after firewall
}

reload() {
    # The client applies its configuration again on SIGHUP: added mounts are mounted,
    # removed ones are detached, and a configuration with an error is refused and logged.
    ebegin "Reloading $RC_SVCNAME"
    supervise-daemon "$RC_SVCNAME" --signal HUP
    eend $?
}
